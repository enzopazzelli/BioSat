{
  "version": 2,
  "placa": "Arduino Uno R3",
  "alimentacion": "Cable USB a la PC (5 V). El mismo cable manda las lecturas.",
  "inventario": "Hecho con las piezas de arduinocomponentes.webp: LCD 16x2 común (sin módulo I2C), sensor de nivel de agua, LM35, DHT11 en módulo, fotoresistencia, LEDs, buzzer, resistencias de 220 Ω y 10 kΩ, potenciómetro B10k, protoboard y cables.",
  "componentes": [
    {"id": "dht11", "nombre": "DHT11", "detalle": "temperatura y humedad del aire", "terminales": ["VCC", "DATA", "GND"]},
    {"id": "led_verde", "nombre": "LED verde", "detalle": "con resistencia de 220 Ω", "terminales": ["ánodo (+)", "cátodo (−)"]},
    {"id": "led_amarillo", "nombre": "LED amarillo", "detalle": "con resistencia de 220 Ω", "terminales": ["ánodo (+)", "cátodo (−)"]},
    {"id": "led_rojo", "nombre": "LED rojo", "detalle": "con resistencia de 220 Ω", "terminales": ["ánodo (+)", "cátodo (−)"]},
    {"id": "buzzer", "nombre": "Buzzer", "detalle": "avisa cuando el suelo está en rojo", "terminales": ["(+)", "(−)"]},
    {"id": "lcd", "nombre": "LCD 16x2 (en paralelo, 4 bits)", "detalle": "los números son los pines de la placa del LCD", "terminales": ["1 VSS", "2 VDD", "3 V0", "4 RS", "5 RW", "6 E", "11 D4", "12 D5", "13 D6", "14 D7", "15 A", "16 K"]},
    {"id": "pot", "nombre": "Potenciómetro B10k", "detalle": "regula el contraste del LCD", "terminales": ["extremo 1", "cursor", "extremo 2"]},
    {"id": "sonda", "nombre": "Sensor de nivel de agua", "detalle": "placa de pistas de cobre; mide conductividad en el suelo", "terminales": ["+", "−", "S"]},
    {"id": "lm35", "nombre": "LM35", "detalle": "temperatura del suelo, 10 mV por °C (sellarlo contra el agua)", "terminales": ["+Vs", "OUT", "GND"]},
    {"id": "ldr", "nombre": "Fotoresistencia + 10 kΩ", "detalle": "luz al ras del suelo (divisor de tensión)", "terminales": ["LDR a 5 V", "nodo", "10 kΩ a GND"]}
  ],
  "conexiones": [
    {"componente": "dht11", "terminal": "VCC", "pin": "5V", "cable": "rojo", "nota": "Las etiquetas del módulo cambian según la marca (S, + y −): guiarse por lo impreso en la placa."},
    {"componente": "dht11", "terminal": "DATA", "pin": "D2", "define": "PIN_DHT", "cable": "amarillo"},
    {"componente": "dht11", "terminal": "GND", "pin": "GND", "cable": "negro"},
    {"componente": "led_verde", "terminal": "ánodo (+)", "pin": "D3", "define": "PIN_LED_VERDE", "cable": "verde"},
    {"componente": "led_verde", "terminal": "cátodo (−)", "pin": "GND", "cable": "negro"},
    {"componente": "led_amarillo", "terminal": "ánodo (+)", "pin": "D4", "define": "PIN_LED_AMARILLO", "cable": "amarillo"},
    {"componente": "led_amarillo", "terminal": "cátodo (−)", "pin": "GND", "cable": "negro"},
    {"componente": "led_rojo", "terminal": "ánodo (+)", "pin": "D5", "define": "PIN_LED_ROJO", "cable": "rojo"},
    {"componente": "led_rojo", "terminal": "cátodo (−)", "pin": "GND", "cable": "negro"},
    {"componente": "buzzer", "terminal": "(+)", "pin": "D6", "define": "PIN_BUZZER", "cable": "naranja"},
    {"componente": "buzzer", "terminal": "(−)", "pin": "GND", "cable": "negro"},
    {"componente": "sonda", "terminal": "+", "pin": "A3", "define": "PIN_SONDA_VCC", "cable": "rojo", "nota": "Se alimenta desde un pin que se prende solo al medir (A3 usado como salida digital): así las pistas no se corroen."},
    {"componente": "sonda", "terminal": "−", "pin": "GND", "cable": "negro"},
    {"componente": "sonda", "terminal": "S", "pin": "A0", "define": "PIN_AGUA", "cable": "azul"},
    {"componente": "lm35", "terminal": "+Vs", "pin": "5V", "cable": "rojo"},
    {"componente": "lm35", "terminal": "OUT", "pin": "A1", "define": "PIN_LM35", "cable": "naranja", "nota": "Se mide con la referencia interna de 1,1 V para ver 0,1 °C; el pin AREF queda sin conectar."},
    {"componente": "lm35", "terminal": "GND", "pin": "GND", "cable": "negro"},
    {"componente": "ldr", "terminal": "LDR a 5 V", "pin": "5V", "cable": "rojo"},
    {"componente": "ldr", "terminal": "nodo", "pin": "A2", "define": "PIN_LDR", "cable": "verde"},
    {"componente": "ldr", "terminal": "10 kΩ a GND", "pin": "GND", "cable": "negro"},
    {"componente": "lcd", "terminal": "1 VSS", "pin": "GND", "cable": "negro"},
    {"componente": "lcd", "terminal": "2 VDD", "pin": "5V", "cable": "rojo"},
    {"componente": "lcd", "terminal": "3 V0", "enlace": {"componente": "pot", "terminal": "cursor"}, "cable": "verde"},
    {"componente": "lcd", "terminal": "4 RS", "pin": "D12", "define": "PIN_LCD_RS", "cable": "azul"},
    {"componente": "lcd", "terminal": "5 RW", "pin": "GND", "cable": "negro", "nota": "RW a GND: el LCD solo se escribe."},
    {"componente": "lcd", "terminal": "6 E", "pin": "D11", "define": "PIN_LCD_E", "cable": "amarillo"},
    {"componente": "lcd", "terminal": "11 D4", "pin": "D10", "define": "PIN_LCD_D4", "cable": "naranja"},
    {"componente": "lcd", "terminal": "12 D5", "pin": "D9", "define": "PIN_LCD_D5", "cable": "azul"},
    {"componente": "lcd", "terminal": "13 D6", "pin": "D8", "define": "PIN_LCD_D6", "cable": "verde"},
    {"componente": "lcd", "terminal": "14 D7", "pin": "D7", "define": "PIN_LCD_D7", "cable": "amarillo"},
    {"componente": "lcd", "terminal": "15 A", "pin": "5V", "cable": "rojo", "nota": "Luz de fondo: pasar por una resistencia de 220 Ω."},
    {"componente": "lcd", "terminal": "16 K", "pin": "GND", "cable": "negro"},
    {"componente": "pot", "terminal": "extremo 1", "pin": "5V", "cable": "rojo"},
    {"componente": "pot", "terminal": "cursor", "enlace": {"componente": "lcd", "terminal": "3 V0"}, "cable": "verde"},
    {"componente": "pot", "terminal": "extremo 2", "pin": "GND", "cable": "negro"}
  ]
}
